# Supabase PostgreSQL connection string - use Session pooler (port 5432, IPv4 resolvable)
# Render has no IPv6, so use *.pooler.supabase.com (NOT db.<ref>.supabase.co).
# prepared_statement_cache_size=0 avoids "prepared statement already exists" with pgbouncer.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?prepared_statement_cache_size=0

# Redis (optional, leave as default for in-memory fallback)
REDIS_URL=redis://localhost:6379/0

# JWT secret - change this in production!
SECRET_KEY=your-super-secret-key-change-in-production

# JWT settings
ALGORITHM=HS256
# Access tokens are short-lived; the refresh token silently renews them.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# Auth cookies (httpOnly). Secure must be true in production (HTTPS).
# For local http development set COOKIE_SECURE=false.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Leave empty for a host-only cookie (recommended).
COOKIE_DOMAIN=

# Site-wide rate limiting (per client IP, fixed window). Set RATE_LIMIT_ENABLED=false
# for local load testing.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WRITE_REQUESTS=40
RATE_LIMIT_WINDOW_SECONDS=60
