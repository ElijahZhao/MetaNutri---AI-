# Supabase PostgreSQL connection string - use Session pooler (port 5432, IPv4 resolvable)
# Render has no IPv6, so use *.pooler.supabase.com (NOT db.<ref>.supabase.co).
# prepared_statement_cache_size=0 avoids "prepared statement already exists" with pgbouncer.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?prepared_statement_cache_size=0

# Redis (optional, leave as default for in-memory fallback)
REDIS_URL=redis://localhost:6379/0

# JWT secret - REPLACE with a high-entropy random string.
# This placeholder is exactly the value app/core/config.py treats as "public
# default": it raises on Render (production) unless ALLOW_DEFAULT_SECRET_KEY=1.
# (ALLOW_DEFAULT_SECRET_KEY is only meant for local dev/docker; never set it in production.)
SECRET_KEY=super-secret-key-change-in-production

# Comma-separated browser origins allowed by CORS (no trailing slash), e.g.
# "https://meta-nutri-ai.vercel.app,http://localhost:3000".
# Optional: with the same-origin Next proxy, browsers don't trigger CORS; this
# only matters for direct API / Swagger access from another origin.
CORS_ORIGINS=

# Public frontend URL, used to build the password-reset link returned by
# /api/auth/forgot-password. Leave empty to return reset_url: null.
FRONTEND_URL=

# JWT settings
ALGORITHM=HS256
# Access tokens are short-lived; the refresh token silently renews them.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# Auth cookies (httpOnly). Secure must be true in production (HTTPS).
# For local http development set COOKIE_SECURE=false.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Leave empty for a host-only cookie (recommended).
COOKIE_DOMAIN=

# Site-wide rate limiting (per client IP, fixed window). Set RATE_LIMIT_ENABLED=false
# for local load testing.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WRITE_REQUESTS=40
RATE_LIMIT_WINDOW_SECONDS=60
